{
  "name": "oakhouse-church-website",
  "private": true,
  "version": "1.0.0",
  "description": "Oak House Church website \u00e2\u20ac\u201d React (Vite) frontend, Node/Express API, MySQL",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "db:setup": "npm run db:setup -w server",
    "db:reset": "npm run db:reset -w server",
    "admin:create": "npm run admin:create -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
